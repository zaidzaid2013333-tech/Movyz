VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_API_BASE_URL="/api/v1"

SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
CORS_ORIGINS="http://localhost:3000"
PORT="8787"

TMDB_API_KEY="YOUR_TMDB_API_KEY"
TMDB_API_READ_ACCESS_TOKEN="YOUR_TMDB_READ_ACCESS_TOKEN"

# Provider resolver (server-side only)
MOVYZA_PROVIDER_TIMEOUT_MS="8000"

# TMDB-native HLS adapters
EZVIDAPI_PROVIDER="vidsrc"
EZVIDAPI_MOVIE_URL_TEMPLATE="https://ezvidapi.com/movie/{{provider}}/{{tmdbId}}"
EZVIDAPI_TV_URL_TEMPLATE="https://ezvidapi.com/tv/{{provider}}/{{tmdbId}}?season={{season}}&episode={{episode}}"
EZVIDAPI_HEALTH_URL=""

STREAMPROVIDER_MOVIE_URL_TEMPLATE="https://streamprovider.byteful.me/?tmdbId={{tmdbId}}"
STREAMPROVIDER_TV_URL_TEMPLATE="https://streamprovider.byteful.me/?tmdbId={{tmdbId}}&season={{season}}&episode={{episode}}"
STREAMPROVIDER_HEALTH_URL=""

# Optional NHD JSON API. A free key is required for JSON extraction.
NHD_API_KEY=""
NHD_MOVIE_URL_TEMPLATE="https://nhdapi.com/movie/{{tmdbId}}?key={{key}}"
NHD_TV_URL_TEMPLATE="https://nhdapi.com/tv/{{tmdbId}}/{{season}}/{{episode}}?key={{key}}"
NHD_HEALTH_URL=""

# Optional mapping-based adapter. Point this to a provider/API you are authorized to use.
FASELHD_API_BASE_URL=""

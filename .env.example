VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_API_BASE_URL="/api/v1"

SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
CORS_ORIGINS="http://localhost:3000"
PORT="8787"

TMDB_API_KEY="YOUR_TMDB_API_KEY"
TMDB_API_READ_ACCESS_TOKEN="YOUR_TMDB_READ_ACCESS_TOKEN"

# Provider resolver (server-side only)
MOVYZA_PROVIDER_TIMEOUT_MS="8000"

# Optional self-hosted MovieBox-API v4 deployment. Leave empty to use the MovieBox H5 backend directly.
MOVIEBOX_API_BASE_URL=""
MOVIEBOX_STREAM_DOMAIN=""
# Use the deployed MovieBox-API /watch route as a zero-buffer first-party playback proxy.
# Requires the deployed service to expose GET /watch/{subject_id} and Range forwarding.
MOVIEBOX_PROXY_PLAYBACK="false"

# EgyBest API (server-side only)
# provider_mappings.provider_content_id should contain the exact EgyBest movie/episode URL.
EGYBEST_API_BASE_URL="https://YOUR_EGYBEST_API"
EGYBEST_ACCESS_TOKEN=""
EGYBEST_MOVIE_PATH="/dls?url={{providerId}}&v=2"
EGYBEST_EPISODE_PATH="/dls?url={{providerId}}&v=2"
EGYBEST_HEALTH_URL=""

# TMDB-ID playback adapters (server-side only)
# These defaults can be overridden only when the provider has authorized/current endpoint documentation.
# TMDB-native HLS adapters
EZVIDAPI_PROVIDER="vidsrc"
EZVIDAPI_MOVIE_URL_TEMPLATE="https://ezvidapi.com/movie/{{provider}}/{{tmdbId}}"
EZVIDAPI_TV_URL_TEMPLATE="https://ezvidapi.com/tv/{{provider}}/{{tmdbId}}?season={{season}}&episode={{episode}}"
EZVIDAPI_HEALTH_URL=""

STREAMPROVIDER_MOVIE_URL_TEMPLATE="https://streamprovider.byteful.me/?tmdbId={{tmdbId}}"
STREAMPROVIDER_TV_URL_TEMPLATE="https://streamprovider.byteful.me/?tmdbId={{tmdbId}}&season={{season}}&episode={{episode}}"
STREAMPROVIDER_HEALTH_URL=""

# NHD API — documented host/endpoints. A key is required for JSON extraction.
# https://nhdapi.st/docs
NHD_API_KEY=""
NHD_MOVIE_URL_TEMPLATE="https://nhdapi.st/movie/{{tmdbId}}?key={{key}}"
NHD_TV_URL_TEMPLATE="https://nhdapi.st/tv/{{tmdbId}}/{{season}}/{{episode}}?key={{key}}"
NHD_HEALTH_URL="https://nhdapi.st/movie/550?key={{key}}"

# Optional mapping-based adapter. Point this to a provider/API you are authorized to use.
FASELHD_API_BASE_URL=""

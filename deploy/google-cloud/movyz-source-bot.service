[Unit]
Description=Movyz autonomous source maintenance bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=movyz
Group=movyz
WorkingDirectory=/opt/movyz
EnvironmentFile=/etc/movyz/movyz.env
ExecStart=/usr/bin/npm run bot
Restart=always
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/movyz

[Install]
WantedBy=multi-user.target

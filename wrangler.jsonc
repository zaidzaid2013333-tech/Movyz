{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movyz-api",
  "main": "worker.ts",
  "compatibility_date": "2026-09-26",
  "cache": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/sitemap.xml", "/sitemap-gsc.xml", "/sitemap/*", "/robots.txt"],
    "html_handling": "none",
    "not_found_handling": "none"
  }
}

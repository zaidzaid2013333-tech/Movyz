{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movyz",
  "main": "worker.ts",
  "compatibility_date": "2026-09-26",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}

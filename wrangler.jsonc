{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movyz-api",
  "main": "worker.ts",
  "compatibility_date": "2026-09-26",
  "cache": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
